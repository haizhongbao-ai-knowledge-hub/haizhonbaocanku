# Copy this file to .env on each computer and fill in real local values.
# Never commit .env.

OPENAI_API_KEY=

# Remote MCP
V0_MCP_BIND_HOST=0.0.0.0
V0_MCP_PORT=8787
V0_MCP_PROTOCOL_VERSION=2025-11-25
V0_MCP_BEARER_TOKEN=
V0_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
V0_RATE_LIMIT_WINDOW_MS=60000
V0_RATE_LIMIT_MAX=120
V0_MCP_LOG_DIR=runtime/mcp_logs

# Repository source for cloud deployment
V0_REPO_ROOT=
V0_REPO_BRANCH=main
V0_GITHUB_REPO=
V0_GITHUB_BRANCH=main
V0_GITHUB_TOKEN=
V0_REPO_REFRESH_ON_START=false
